{
  // Assets-only Worker: Cloudflare serves the built static files and nothing else.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "montrack",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
